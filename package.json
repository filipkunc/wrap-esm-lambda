{
  "name": "@wrap-esm-lambda/engine-oxc",
  "version": "0.4.0",
  "description": "Declarative patching for Node.js modules — ESM, CJS, dual packages and core builtins — via a generic exports tap, delivered at runtime or build time from one config.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipkunc/wrap-esm-lambda.git",
    "directory": "."
  },
  "license": "MIT",
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "node-addon-api"
  ],
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "napi": {
    "binaryName": "wrap-esm-lambda",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "wasm32-wasip1-threads"
    ]
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmarks/transform/bench.ts",
    "matrix": "node tests/interplay-matrix/run.mjs",
    "corpus": "node tests/corpus/run.mts",
    "corpus:bench": "node tests/corpus/bench.mts",
    "bench:chart": "node --import @oxc-node/core/register benchmarks/transform/make-transform-chart.ts",
    "build:packages": "tsc -b packages/core packages/hooks packages/unplugin",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "format": "run-p format:prettier format:rs format:toml",
    "format:prettier": "prettier . -w",
    "format:check": "prettier --check .",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "oxlint . --deny-warnings",
    "prepublishOnly": "napi prepublish -t npm",
    "publish:rehearsal": "sh .github/scripts/publish-rehearsal.sh",
    "registry:up": "sh .github/scripts/local-registry.sh up",
    "registry:publish": "sh .github/scripts/local-registry.sh publish",
    "registry:smoke": "sh .github/scripts/local-registry.sh smoke",
    "registry:status": "sh .github/scripts/local-registry.sh status",
    "registry:down": "sh .github/scripts/local-registry.sh down",
    "test": "pnpm build:packages && cross-env OXC_TSCONFIG_PATH=./tests/tsconfig.json node --import @oxc-node/core/register --test \"tests/*.spec.ts\"",
    "version": "napi version",
    "prepare": "husky",
    "compile:bench": "tsc --project benchmarks/transform/tsconfig.json",
    "typecheck": "pnpm build:packages && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p tests/corpus/tsconfig.json"
  },
  "devDependencies": {
    "@apm-js-collab/code-transformer": "^0.18.0",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@jridgewell/remapping": "^2.3.5",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@napi-rs/cli": "~3.7.4",
    "@napi-rs/wasm-runtime": "^1.0.1",
    "@oxc-node/core": "^0.0.30",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rspack/core": "^2.1.5",
    "@smithy/core": "^3.29.5",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.0",
    "@types/node": "^26.1.2",
    "@types/semver": "^7.7.0",
    "@wrap-esm-lambda/core": "workspace:^",
    "@wrap-esm-lambda/engine-acorn": "workspace:^",
    "@wrap-esm-lambda/hooks": "workspace:^",
    "@wrap-esm-lambda/unplugin": "workspace:^",
    "chalk": "^5.4.1",
    "chart.js": "^4.5.0",
    "chartjs-node-canvas": "^5.0.0",
    "cross-env": "^10.1.0",
    "emnapi": "^1.11.3",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "fastify": "^5.10.0",
    "hono": "^4.12.34",
    "husky": "^9.1.7",
    "import-in-the-middle": "^3.3.1",
    "js-yaml": "4.3.1",
    "lint-staged": "^16.1.2",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.8.0",
    "pkg-pr-new": "^0.0.87",
    "prettier": "^3.6.2",
    "rolldown": "^1.2.0",
    "rollup": "^4.62.2",
    "semver": "^7.8.5",
    "tinybench": "6.1.2",
    "typescript": "^7.0.2",
    "unplugin": "^3.3.0",
    "webpack": "^5.109.0"
  },
  "lint-staged": {
    "*.@(js|mjs|cjs|ts|mts|cts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|mjs|cjs|ts|mts|cts|tsx|yml|yaml|md|json)": [
      "prettier --write"
    ],
    "*.toml": [
      "taplo format"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "packageManager": "pnpm@11.20.0",
  "homepage": "https://github.com/filipkunc/wrap-esm-lambda#readme",
  "bugs": {
    "url": "https://github.com/filipkunc/wrap-esm-lambda/issues"
  }
}

{
  "name": "wrap-esm-lambda",
  "version": "0.1.3",
  "description": "Native Node.js addon to wrap AWS Lambda handler written in ESM.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipkunc/wrap-esm-lambda.git"
  },
  "license": "MIT",
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "node-addon-api"
  ],
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "napi": {
    "binaryName": "wrap-esm-lambda",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "wasm32-wasip1-threads"
    ]
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "bench:patch": "node --import @oxc-node/core/register benchmark/patch-bench.ts",
    "matrix": "node hooks/interplay-matrix/run.mjs",
    "bench:chart": "node --import @oxc-node/core/register benchmark/make-transform-chart.ts",
    "build:packages": "tsc -b packages/core packages/hooks packages/unplugin",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "format": "run-p format:prettier format:rs format:toml",
    "format:prettier": "prettier . -w",
    "format:check": "prettier --check .",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "oxlint . --deny-warnings",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "pnpm build:packages && cross-env OXC_TSCONFIG_PATH=./__test__/tsconfig.json node --import @oxc-node/core/register --test \"__test__/*.spec.ts\"",
    "version": "napi version",
    "prepare": "husky",
    "compile:bench": "tsc --project benchmark/tsconfig.json",
    "typecheck": "pnpm build:packages && tsc --noEmit -p __test__/tsconfig.json"
  },
  "devDependencies": {
    "@apm-js-collab/code-transformer": "^0.18.0",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@babel/core": "^7.28.0",
    "@emnapi/core": "^1.4.5",
    "@emnapi/runtime": "^1.4.5",
    "@jridgewell/remapping": "^2.3.5",
    "@jridgewell/source-map": "^0.3.11",
    "@jridgewell/trace-mapping": "^0.3.25",
    "@napi-rs/cli": "^3.0.3",
    "@napi-rs/wasm-runtime": "^1.0.1",
    "@oxc-node/core": "^0.0.30",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rspack/core": "^2.1.5",
    "@smithy/core": "^3.29.5",
    "@swc/core": "^1.13.3",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.0",
    "@types/babel__core": "^7.20.5",
    "@types/estraverse": "^5",
    "@types/estree": "^1.0.9",
    "@types/node": "^24.2.0",
    "@types/semver": "^7.7.0",
    "@wrap-esm-lambda/core": "workspace:^",
    "@wrap-esm-lambda/engine-acorn": "workspace:^",
    "@wrap-esm-lambda/hooks": "workspace:^",
    "@wrap-esm-lambda/unplugin": "workspace:^",
    "acorn": "^8.15.0",
    "astring": "^1.9.0",
    "chalk": "^5.4.1",
    "chart.js": "^4.5.0",
    "chartjs-node-canvas": "^5.0.0",
    "cross-env": "^10.1.0",
    "emnapi": "~1.4.5",
    "esbuild": "^0.28.1",
    "estraverse": "^5.3.0",
    "express": "^5.2.1",
    "fastify": "^5.10.0",
    "hono": "^4.12.31",
    "husky": "^9.1.7",
    "import-in-the-middle": "^3.3.1",
    "lint-staged": "^16.1.2",
    "node-estree": "^4.0.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.8.0",
    "prettier": "^3.6.2",
    "rolldown": "^1.2.0",
    "rollup": "^4.62.2",
    "semver": "^7.8.5",
    "source-map": "^0.7.6",
    "tinybench": "^4.0.1",
    "typescript": "^5.8.3",
    "unplugin": "^3.3.0",
    "webpack": "^5.109.0"
  },
  "lint-staged": {
    "*.@(js|mjs|cjs|ts|mts|cts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|mjs|cjs|ts|mts|cts|tsx|yml|yaml|md|json)": [
      "prettier --write"
    ],
    "*.toml": [
      "taplo format"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "packageManager": "pnpm@11.13.0",
  "homepage": "https://github.com/filipkunc/wrap-esm-lambda#readme",
  "bugs": {
    "url": "https://github.com/filipkunc/wrap-esm-lambda/issues"
  }
}

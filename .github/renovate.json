{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "group:allNonMajor",
    ":preserveSemverRanges",
    ":disablePeerDependencies",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchPackageNames": ["@napi/cli", "napi", "napi-build", "napi-derive"],
      "addLabels": ["napi-rs"],
      "groupName": "napi-rs"
    },
    {
      "matchPackagePatterns": ["^eslint", "^@typescript-eslint"],
      "groupName": "linter"
    }
  ],
  "commitMessagePrefix": "chore: ",
  "commitMessageAction": "bump up",
  "commitMessageTopic": "{{depName}} version",
  "ignoreDeps": [],
  "customManagers": [
    {
      "description": "Zig is pinned inside a run step, where no manager would look for it. Without this the pin quietly rots while every other dependency stays current.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.yml$/"],
      "matchStrings": ["ziglang==(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "ziglang",
      "datasourceTemplate": "pypi"
    }
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "commitMessagePrefix": "fix: ",
    "groupName": null,
    "minimumReleaseAge": null,
    "schedule": []
  }
}

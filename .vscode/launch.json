{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  // The three "spec file" configs below debug whatever spec is in the active
  // editor, via ${file}. VS Code expands that from the focused editor tab and
  // has no fallback, so launching from the Run and Debug view with no editor
  // focused fails outright with "Variable ${file} can not be resolved" — open
  // the spec and click into it first. For a run that does not depend on focus,
  // the "test (full suite)" task covers the whole suite.
  "configurations": [
    {
      // WRAP_ESM_LAMBDA_ENGINE is EXPLICIT here for the same reason every CI
      // lane names it: core falls back to the pure-JS acorn engine when the
      // addon cannot be loaded, so an implicit run would have you debugging a
      // different engine than the one you think you are in.
      "name": "Debug spec file (oxc)",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "runtimeArgs": ["--import", "@oxc-node/core/register", "--test"],
      "env": {
        "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json",
        "WRAP_ESM_LAMBDA_ENGINE": "oxc"
      },
      "preLaunchTask": "build:packages",
      // Without the second entry, stepping into any import lands you inside the
      // oxc register hook's transform rather than in the module you asked for.
      "skipFiles": ["<node_internals>/**", "**/node_modules/@oxc-node/**"],
      "console": "integratedTerminal"
    },
    {
      // The acorn twin. Engine-parity bugs are the ones worth a debugger, and
      // they are found by running the same spec under both.
      "name": "Debug spec file (acorn)",
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "runtimeArgs": ["--import", "@oxc-node/core/register", "--test"],
      "env": {
        "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json",
        "WRAP_ESM_LAMBDA_ENGINE": "acorn"
      },
      "preLaunchTask": "build:packages",
      "skipFiles": ["<node_internals>/**", "**/node_modules/@oxc-node/**"],
      "console": "integratedTerminal"
    },
    {
      // Breakpoints in src/*.rs. Requires the CodeLLDB extension and a debug
      // addon — build:debug overwrites the release .node at the same path, so
      // run the "build (release addon)" task before benchmarking again.
      //
      // `program` cannot be a bare "node": CodeLLDB takes a path, not a PATH
      // lookup, so that spelling never launches. Hardcoding an interpreter
      // path would break for everyone but its author (this repo is developed
      // against nvm-managed and system nodes alike), so the preLaunchTask
      // symlinks whatever `node` is on PATH to .vscode/node (gitignored) and
      // the config points at the symlink.
      "name": "Debug Rust addon (spec file)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/node",
      "args": ["--import", "@oxc-node/core/register", "--test", "${file}"],
      "cwd": "${workspaceFolder}",
      "env": {
        "OXC_TSCONFIG_PATH": "./__test__/tsconfig.json",
        "WRAP_ESM_LAMBDA_ENGINE": "oxc"
      },
      "preLaunchTask": "prepare rust debug",
      "sourceLanguages": ["rust"]
    },
    {
      // The cold-start bench harness under a debugger: hooks/runtime.mjs (the
      // same entry hyperfine times in bench_hooks.sh) with one of the bench's
      // --import hook entries, picked at launch. cwd is hooks/ so the entry
      // specifiers match the bench script's command lines exactly.
      //
      // The register-tap entries load the compiled workspace packages (hence
      // the preLaunchTask), and the oxc one additionally needs an addon built
      // once via the "build (release addon)" task — with the engine pinned to
      // oxc there is no silent acorn fallback to paper over a missing .node.
      "name": "Debug hooks bench (pick hook)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/hooks/runtime.mjs",
      "runtimeArgs": ["--import", "${input:hookEntry}"],
      "cwd": "${workspaceFolder}/hooks",
      "preLaunchTask": "build:packages",
      "skipFiles": ["<node_internals>/**"],
      "console": "integratedTerminal"
    },
    {
      // The Rust half of the "Debug hooks bench (Rust + JS)" compound. Launch
      // it alone and it hangs at startup by design — --inspect-brk parks node
      // before the first line of user code and never resumes until a JS
      // debugger attaches, which is what the compound's other half does. That
      // park is also the synchronisation: it removes any race between LLDB
      // getting the process up and the attach finding the inspector port.
      //
      // No preLaunchTask here on purpose. In a compound VS Code starts the
      // members without waiting, so a member-level build would leave the
      // attach half racing a cargo build it cannot see; the task belongs on
      // the compound, which does run once before either member starts.
      "name": "hooks bench: Rust half (compound member)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/.vscode/node",
      "args": ["--inspect-brk=9229", "--import", "${input:hookEntry}", "runtime.mjs"],
      "cwd": "${workspaceFolder}/hooks",
      "sourceLanguages": ["rust"]
    },
    {
      // The JS half. Attaches to the port the Rust half opened — no program,
      // no args, so the hook entry is prompted for exactly once (by the member
      // above) rather than once per session.
      "name": "hooks bench: JS half (compound member)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "cwd": "${workspaceFolder}/hooks",
      "skipFiles": ["<node_internals>/**", "**/node_modules/@oxc-node/**"]
    }
  ],
  "compounds": [
    {
      // Rust and JS breakpoints in one process at the same time: CodeLLDB has
      // it under ptrace while V8's inspector runs in-process over a socket, so
      // the two debuggers do not contend. This is the config for the seam the
      // bench actually exercises — a JS breakpoint in the register hook and a
      // Rust breakpoint in the transform it calls into, in one run.
      //
      // Expect the JS session to look frozen whenever LLDB is stopped in Rust.
      // It is not wedged; the whole process is stopped, inspector included.
      //
      // Requires a DEBUG addon for the Rust breakpoints to bind — that is what
      // "prepare rust debug" builds. It overwrites the same .node the release
      // build writes, so re-run "build (release addon)" before trusting a
      // bench number again.
      "name": "Debug hooks bench (Rust + JS)",
      "configurations": ["hooks bench: Rust half (compound member)", "hooks bench: JS half (compound member)"],
      "preLaunchTask": "prepare rust debug",
      "stopAll": true
    }
  ],
  "inputs": [
    {
      // The bench_hooks.sh ladder, minus the no-hook baseline (nothing to
      // debug there that "Debug spec file" does not already cover better).
      "id": "hookEntry",
      "type": "pickString",
      "description": "Hook entry to --import before hooks/runtime.mjs",
      "options": [
        "./register-tap-oxc.mjs",
        "./register-tap-acorn.mjs",
        "./sync-hooks-noop.mjs",
        "./sync-hooks-orchestrion.mjs",
        "./sync-hooks-orchestrion-tracing.mjs"
      ],
      "default": "./register-tap-oxc.mjs"
    }
  ]
}

{
  // This repo lints with oxlint and formats with prettier + rustfmt + taplo.
  // Without this list VS Code suggests ESLint, and a contributor ends up with a
  // toolchain that disagrees with `pnpm lint` and `pnpm format:check`.
  "recommendations": [
    "rust-lang.rust-analyzer",
    // CodeLLDB — required by the "Debug Rust addon" launch config
    "vadimcn.vscode-lldb",
    // Puts the specs in the built-in Testing view. The Rust half needs no
    // extension: rust-analyzer speaks the native testing API itself, gated
    // behind rust-analyzer.testExplorer in settings.json.
    "connor4312.nodejs-testing",
    "oxc.oxc-vscode",
    "tamasfe.even-better-toml",
    "esbenp.prettier-vscode",
    "editorconfig.editorconfig"
  ],
  "unwantedRecommendations": [
    "dbaeumer.vscode-eslint",
    // Deprecated by its own author, and redundant since VS Code 1.59 shipped a
    // native testing API — both adapters above target that directly. Its README:
    // "this extension is now deprecated". Since 2.22.0 it defaults to rendering
    // through the native UI anyway, so it contributes nothing here.
    "hbenl.vscode-test-explorer",
    "ms-vscode.test-adapter-converter"
  ]
}

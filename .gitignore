#Added by cargo

/target

*.node
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
/npm

/benchmark/lib
/hooks/.swc/
*.wasm

# napi-generated, and rebuilt in full by any single `napi build` regardless of
# which target it was pointed at — the file set is driven by napi.targets in
# package.json, not by the host.
#
# These were tracked until the loader was found still expecting 0.2.2 after the
# addon had moved to 0.2.3: nothing rebuilds them on a version bump, and the
# publish job ships the checked-in copy rather than a freshly built one, so the
# staleness would have reached npm. Committed build output cannot go stale
# loudly, which is the whole argument against committing it.
#
# CI propagates them as the `binding-glue` artifact (built once in the `build`
# job); locally `pnpm build` writes them. See README's Development section.
/index.js
/index.d.ts
/browser.js
/wasi-worker.mjs
/wasi-worker-browser.mjs
/wrap-esm-lambda.wasi.cjs
/wrap-esm-lambda.wasi-browser.js
.swc/

# Generated by hooks/sourcemap-ts-demo/run.sh
/hooks/sourcemap-ts-demo/handler.js
/hooks/sourcemap-ts-demo/handler.js.map

# The "link node for lldb" task pins the PATH-resolved node here so the
# CodeLLDB launch config has a stable program path to point at.
/.vscode/node

{
  "name": "@wrap-esm-lambda/engine-acorn",
  "version": "0.2.3",
  "description": "Pure-JavaScript engine for wrap-esm-lambda: the same transform surface as the native oxc addon, built on acorn + magic-string. Lets the hybrid instrumentation run JS-only, and benchmarks the JS-vs-Rust trade-off.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipkunc/wrap-esm-lambda.git",
    "directory": "packages/engine-acorn"
  },
  "homepage": "https://github.com/filipkunc/wrap-esm-lambda/tree/main/packages/engine-acorn#readme",
  "bugs": {
    "url": "https://github.com/filipkunc/wrap-esm-lambda/issues"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "acorn": "^8.15.0",
    "magic-string": "^0.30.17"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "typescript": "^7.0.2"
  }
}

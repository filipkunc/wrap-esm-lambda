{
  "name": "@wrap-esm-lambda/hooks",
  "version": "0.1.0",
  "description": "Runtime instrumentation for wrap-esm-lambda: wraps matched modules at load time via module.registerHooks. The zero-build-changes half of the hybrid setup.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./register": {
      "types": "./dist/register.d.mts",
      "default": "./dist/register.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.15.0"
  },
  "dependencies": {
    "@wrap-esm-lambda/core": "workspace:^"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "typescript": "^5.8.3"
  }
}

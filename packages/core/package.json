{
  "name": "@wrap-esm-lambda/core",
  "version": "0.1.0",
  "description": "Shared config, matcher and transform glue for wrap-esm-lambda's runtime (loader hook) and build-time (bundler plugin) instrumentation shells.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./range": {
      "types": "./dist/range.d.mts",
      "default": "./dist/range.mjs"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.mts",
      "default": "./dist/diagnostics.mjs"
    },
    "./validate": {
      "types": "./dist/validate.d.mts",
      "default": "./dist/validate.mjs"
    }
  },
  "bin": {
    "wrap-esm-lambda-validate": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipkunc/wrap-esm-lambda.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/filipkunc/wrap-esm-lambda/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/filipkunc/wrap-esm-lambda/issues"
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "dependencies": {
    "@wrap-esm-lambda/engine-acorn": "workspace:^"
  },
  "optionalDependencies": {
    "wrap-esm-lambda": "workspace:^"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "typescript": "^5.8.3"
  }
}

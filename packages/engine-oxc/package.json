{
  "name": "@wrap-esm-lambda/engine-oxc",
  "version": "0.4.0",
  "description": "Native OXC transform engine for wrap-esm-lambda.",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipkunc/wrap-esm-lambda.git",
    "directory": "packages/engine-oxc"
  },
  "homepage": "https://github.com/filipkunc/wrap-esm-lambda/tree/main/packages/engine-oxc#readme",
  "bugs": {
    "url": "https://github.com/filipkunc/wrap-esm-lambda/issues"
  },
  "license": "MIT",
  "keywords": [
    "napi-rs",
    "NAPI",
    "N-API",
    "Rust",
    "node-addon",
    "node-addon-api"
  ],
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "napi": {
    "binaryName": "wrap-esm-lambda",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "wasm32-wasip1-threads"
    ]
  },
  "engines": {
    "node": ">= 22.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "version": "napi version"
  }
}

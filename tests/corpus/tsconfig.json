{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The corpus is an APP, not a workspace package: nothing is emitted — the
  // .mts/.cts files run directly on Node's native type stripping (the
  // runner's Node floor, >= 22.22.3, is past the 22.18 line where stripping
  // is on by default). `erasableSyntaxOnly` pins that contract: whatever
  // typechecks here is guaranteed to be runnable by stripping alone.
  // Deliberately NOT extending tsconfig.base.json: no composite/declaration
  // machinery, and no verbatimModuleSyntax so the .cts files (the require()
  // consumer cell and its fingerprint helper, CJS by design — see
  // lib/fingerprint.cts) keep plain module.exports ergonomics.
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["**/*.mts", "**/*.cts"],
  "exclude": ["node_modules", ".scratch"]
}

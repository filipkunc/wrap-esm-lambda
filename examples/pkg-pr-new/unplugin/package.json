{
  "name": "tutorial-unplugin-instrumentation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tutorial: patch hono (a dual ESM+CJS package) at build time via the unplugin (esbuild here), installing wrap-esm-lambda from pkg.pr.new previews.",
  "scripts": {
    "build": "node build.mjs",
    "start": "node build.mjs && node dist/app.mjs",
    "check:compat": "node compat-check.cjs"
  },
  "devDependencies": {
    "@wrap-esm-lambda/core": "https://pkg.pr.new/filipkunc/wrap-esm-lambda/@wrap-esm-lambda/core@main",
    "@wrap-esm-lambda/unplugin": "https://pkg.pr.new/filipkunc/wrap-esm-lambda/@wrap-esm-lambda/unplugin@main",
    "esbuild": "^0.28.1",
    "hono": "^4.12.34"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "optionalDependencies": {
    "@wrap-esm-lambda/engine-oxc": "https://pkg.pr.new/filipkunc/wrap-esm-lambda/@wrap-esm-lambda/engine-oxc@main",
    "wrap-esm-lambda": "https://pkg.pr.new/filipkunc/wrap-esm-lambda/wrap-esm-lambda@main"
  }
}
